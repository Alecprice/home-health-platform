{
  "name": "@homehealth/api",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "db:migrate": "tsx src/db/migrate.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "5.2.1",
    "pg": "8.16.3",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "tsx": "4.22.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
